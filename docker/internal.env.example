# Copy to ".env" next to docker-compose.yml on the server and fill in. Never commit the real file.

# Database password: letters and digits only (it is placed inside a connection URL).
POSTGRES_PASSWORD=

# The site asks for this password (any username). Required: the server refuses to start without it.
LENDMATCH_ACCESS_CODE=

# Optional. Without an Anthropic key the app runs in offline mode: nothing the borrower types is sent to any AI service.
ANTHROPIC_API_KEY=
# Needed to read lender websites (research / cache:warm). The borrower's details are never sent to Firecrawl.
FIRECRAWL_API_KEY=

# Who can reach the app. 127.0.0.1 = this machine only (put a reverse proxy / VPN gateway in front).
# Use the server's internal IP (for example 10.0.0.12) to expose it on the company network. Never 0.0.0.0 on a public host.
LENDMATCH_BIND=127.0.0.1
LENDMATCH_PORT=3000

# Optional
LENDMATCH_MAX_LENDERS=40
LENDMATCH_DISCOVERY=on
