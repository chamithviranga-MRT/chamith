{
  "name": "lendmatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "eval": "tsx scripts/eval.ts",
    "postinstall": "prisma generate",
    "eval:fixtures": "tsx scripts/eval.ts --mode=fixtures",
    "eval:live": "tsx scripts/eval.ts --mode=live",
    "test:eval": "vitest run tests/eval.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@mendable/firecrawl-js": "^4.42.4",
    "@prisma/client": "^6.19.3",
    "docx": "^9.8.1",
    "next": "^15.5.26",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "jszip": "^3.10.2",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
