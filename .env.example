# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
DATABASE_URL=postgresql://lendmatch:lendmatch@localhost:5432/lendmatch?schema=public

# Optional
# LENDMATCH_ACCESS_CODE=      # set on a public deployment: the site asks for this password (any username)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# FIRECRAWL_USE_AGENT=0        # 1 = use Firecrawl agent as a fallback for pages with no usable data (costs more credits)
# LENDMATCH_MAX_LENDERS=40     # cap on lenders scanned per run
# LENDMATCH_DISCOVERY=off      # skip profile-driven lender discovery (saves Firecrawl credits)
