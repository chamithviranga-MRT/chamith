# Copy to .env.local for local dev, or set these in Vercel > Project > Settings > Environment Variables.
# Without them the app runs in demo mode (sample sourcing results and rule-based scoring).
EXA_API_KEY=
# Claude: on Vercel, AI Gateway uses the deployment's OIDC token automatically.
# Locally, set one of these (gateway preferred):
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: protects the whole site with a browser password prompt (any username, this password).
ACCESS_CODE=
